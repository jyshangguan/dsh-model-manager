{
  "name": "@jyshangguan/dsh-model-manager",
  "version": "0.1.0",
  "type": "module",
  "description": "Role-based model manager for DeepSeek Harness: assign models to planning, execution, vision and main roles, route subagent work by role, and report which model every subagent used.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "model-routing",
    "subagent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jyshangguan/dsh-model-manager.git"
  },
  "homepage": "https://github.com/jyshangguan/dsh-model-manager#readme",
  "bugs": {
    "url": "https://github.com/jyshangguan/dsh-model-manager/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "meta": {
    "title": "Model manager",
    "description": "Assign models to planning, execution, vision and main roles, and see which model each subagent used."
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
